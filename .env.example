# fireclaw-search-mcp environment variables.
# Copy to `.env` (gitignored) and fill in any overrides.

# --- Required ---------------------------------------------------------------
# Firecrawl API key. Get a free one at https://www.firecrawl.dev
# The 1,000 credits/month free tier is enough for sustained single-agent use.
FIRECRAWL_API_KEY=

# --- Transport (Streamable HTTP vs stdio) -----------------------------------
# "http" (Streamable HTTP, default) or "stdio".
FIRECRAWL_TRANSPORT=http

# Bind address when transport=http. Loopback only by design;
# VS Code's "Forward a Port" tunnels this through Microsoft's relay.
FIRECRAWL_HOST=127.0.0.1
FIRECRAWL_PORT=8000

# Path prefix for the Streamable HTTP endpoint. Clients must include this.
FIRECRAWL_PATH=/mcp

# --- Cache ------------------------------------------------------------------
# On-disk cache directory for Firecrawl responses (per SPECS §6). Gitignored.
FIRECRAWL_CACHE_DIR=./cache/firecrawl

# Cache freshness in seconds. 0 disables the cache (every call burns credits).
FIRECRAWL_CACHE_TTL_SECS=86400

# --- Safety rails -----------------------------------------------------------
# Refuse a web_search call if the cached credit counter is at or below this
# value. Set to 0 to disable (NOT recommended on a free-tier key — a runaway
# loop can otherwise drain the budget in a few iterations).
FIRECRAWL_MIN_CREDITS=4

# Per-result markdown cap (≈2k tokens). A page body longer than this is
# truncated and a marker is appended; `markdown_chars` /
# `markdown_truncated_chars` tell the model how much was cut.
FIRECRAWL_MAX_MARKDOWN_CHARS=8000

# Minimum spacing between upstream Firecrawl calls in milliseconds. Set to 0
# to disable (callspace enforcement lets the upstream rate-limiter breathe).
FIRECRAWL_MIN_INTERVAL_MS=0

# Upstream HTTP request timeout in seconds.
FIRECRAWL_HTTP_TIMEOUT_S=60

# --- Logging ----------------------------------------------------------------
# Log level. Accepted: DEBUG, INFO, WARNING, ERROR. Logs go to stderr.
# Accepts both MCP_LOG_LEVEL (legacy) and FASTMCP_LOG_LEVEL (FastMCP 4 default).
MCP_LOG_LEVEL=WARNING

# --- Notes ------------------------------------------------------------------
# `FIRECLAW_API_KEY` is also accepted as a legacy alias for `FIRECRAWL_API_KEY`
# (the project name uses the misspelling). Prefer the correctly-spelled
# variable; the alias exists only for parity with older deployment scripts.
